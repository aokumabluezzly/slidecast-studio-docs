    "title": "このページの使い方",
    "blocks": [
      {
        "type": "html",
        "html": "<style>.chapter .video-facade-label{display:none}.data-table .seek-at{display:inline-block;margin-left:.4em;color:var(--muted);font-size:.85em;white-space:nowrap}.data-table .yt-out{margin-left:.5em;text-decoration:none}</style><script>addEventListener('DOMContentLoaded',()=>{document.querySelectorAll('.chapter .video-embed').forEach(fig=>{fig._facade=fig.querySelector('.video-facade');fig._embed=fig._facade&&fig._facade.dataset.embed;});document.querySelectorAll('details.chapter').forEach(ch=>ch.addEventListener('toggle',()=>{if(ch.open)return;ch.querySelectorAll('.video-embed.is-playing').forEach(fig=>{const frame=fig.querySelector('iframe');if(frame&&fig._facade){frame.replaceWith(fig._facade);fig.classList.remove('is-playing');}});}));document.querySelectorAll('a.seek[data-start]').forEach(a=>a.addEventListener('click',e=>{const box=a.closest('.inline-detail-body')||a.closest('.chapter-inner');const fig=box&&box.querySelector('.video-embed');if(!fig||!fig._embed)return;e.preventDefault();const url=fig._embed+'&start='+Number(a.dataset.start);const frame=fig.querySelector('iframe');if(frame){frame.src=url;}else{fig._facade.dataset.embed=url;fig._facade.click();fig._facade.dataset.embed=fig._embed;}fig.scrollIntoView({block:'center'});}));});</script><p>SlideCast Studio の使い方動画を、作品を作る順に章へ分けて並べました。<strong>v5.5「SPOTLIGHT」の画面</strong>で撮り直したシリーズ（第2版）です。各章には、章全体を通して見られる<strong>まとめ動画</strong>と、1つの機能だけを短く解説する<strong>機能別の動画</strong>があります。</p>"
      },
